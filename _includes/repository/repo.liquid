{% assign parts = include.repository.name | split: '/' %}
{% assign owner = parts[0] %}
{% assign name = parts[1] %}

<div class="repo-card">
  <a class="repo-card-title" href="https://github.com/{{ include.repository.name }}" title="{{ include.repository.name }}">
    <i class="fa-brands fa-github"></i>
    {% unless site.data.repositories.github_users contains owner -%}
      <span class="repo-owner">{{ owner }}/</span>
    {%- endunless %}
    <span class="repo-name">{{ name }}</span>
  </a>
  <p class="repo-card-description">{{ include.repository.description }}</p>
  {% if include.repository.language %}
    <p class="repo-card-meta">
      {% comment %} A repository can list several languages, separated by commas. Each one gets its own dot. {% endcomment %}
      {% assign languages = include.repository.language | split: ',' %}
      {% for language in languages %}
        {% assign trimmed = language | strip %}
        <span><span class="repo-lang-dot repo-lang-{{ trimmed | slugify }}"></span>{{ trimmed }}</span>
      {% endfor %}
    </p>
  {% endif %}
</div>
